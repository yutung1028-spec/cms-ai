# Copy to .env in this project root. Do not commit .env or API keys.
#
# TypeScript DeepSeekHarness 0.2.1-rc.5 has no apiKey option.
# The official adapter resolves DEEPSEEK_API_KEY from:
#   1. the process environment
#   2. $DSH_HOME/.credentials.yaml
#   3. the app directory .env
#   4. $DSH_HOME/.env
# Do not assume the SDK reads the key by itself.

# Mapped explicitly to the child process DSH_HOME. The SDK does not read
# ACCESSIBILITY_DSH_HOME by itself.
ACCESSIBILITY_DSH_HOME=/Users/augustinewong/.dsh-accessibility-cms
ACCESSIBILITY_DSH_PROFILE=sdk
ACCESSIBILITY_DSH_PROVIDER=deepseek-official
ACCESSIBILITY_DSH_MODEL=deepseek-flash
ACCESSIBILITY_DSH_MAX_TOKENS=4096

# Optional. mock skips DSH. Omit or leave unset for dsh when home + credentials exist.
# ACCESSIBILITY_ASSISTANT_BACKEND=mock

# Fill locally. Do not commit this value.
# DEEPSEEK_API_KEY=

# maxTokens / timeout / tool-call counts are per-request caps, not a spend ceiling.
